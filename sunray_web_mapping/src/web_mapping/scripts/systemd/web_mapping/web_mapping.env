# Runtime environment for web_mapping.service.
# Edit this file, then run:
#   sudo systemctl restart web_mapping.service

# Leave ROS_DISTRO empty to auto-detect from the workspace install chain or
# from /opt/ros/*/setup.bash. Set it to foxy, humble, etc. to pin a distro.
ROS_DISTRO=
PYTHONUNBUFFERED=1
RCUTILS_LOGGING_BUFFERED_STREAM=1

# Optional ROS graph isolation.
WEB_MAPPING_ROS_DOMAIN_ID=
WEB_MAPPING_ROS_LOCALHOST_ONLY=

# Launch the integrated sunray_web_mapping stack by default. Set
# WEB_MAPPING_LAUNCH_PACKAGE=web_mapping and WEB_MAPPING_LAUNCH_FILE=web_mapping.launch.py
# for a standalone browser bridge.
WEB_MAPPING_LAUNCH_PACKAGE=web_fast_lio_broker
WEB_MAPPING_LAUNCH_FILE=mid360_web_mapping.launch.py
WEB_MAPPING_LAUNCH_ARGS_MODE=none

# WebSocket/Web UI bind address.
WEB_MAPPING_WEB_HOST=0.0.0.0
WEB_MAPPING_WEB_PORT=8765

# Relative paths are resolved from WEB_MAPPING_WORKSPACE.
WEB_MAPPING_MAP_HISTORY_ROOT=maps
WEB_MAPPING_MAP_HISTORY_LIMIT=20

# ROS topic bridge settings.
WEB_MAPPING_RAW_CLOUD_TOPIC=/web_mapping/raw_cloud
WEB_MAPPING_OPTIMIZED_CLOUD_TOPIC=/web_mapping/current_frame
WEB_MAPPING_MAP_CLOUD_TOPIC=/web_mapping/global_map
WEB_MAPPING_POSE_TOPIC=/web_mapping/pose
WEB_MAPPING_RAW_PATH_TOPIC=/web_mapping/raw_path
WEB_MAPPING_OPTIMIZED_PATH_TOPIC=/web_mapping/optimized_path
WEB_MAPPING_IMU_TOPIC=/web_mapping/imu
WEB_MAPPING_LIDAR_STATUS_TOPIC=/web_mapping/lidar_status
WEB_MAPPING_COMMAND_TOPIC=/web_mapping/command
WEB_MAPPING_STATUS_TOPIC=/web_mapping/status
WEB_MAPPING_USE_BROKER_BACKEND=true

# Browser point limits and update intervals. Empty values use launch defaults.
WEB_MAPPING_MAX_POINTS_PER_CLOUD=0
WEB_MAPPING_MAX_RAW_POINTS_PER_CLOUD=5000
WEB_MAPPING_MAX_OPTIMIZED_POINTS_PER_CLOUD=8000
WEB_MAPPING_MAX_MAP_POINTS_PER_CLOUD=200000
WEB_MAPPING_MIN_CLOUD_INTERVAL_SEC=0.15
WEB_MAPPING_MIN_RAW_CLOUD_INTERVAL_SEC=0.5
WEB_MAPPING_MIN_MAP_INTERVAL_SEC=0.5
WEB_MAPPING_MIN_TELEMETRY_INTERVAL_SEC=0.1
WEB_MAPPING_PATH_MAX_POINTS=5000

# CleanMap v1 post-processing for the integrated FAST-LIO launch.
WEB_MAPPING_CLEAN_MAP_ENABLED=true
WEB_MAPPING_CLEAN_MAP_VOXEL_SIZE=0.05
WEB_MAPPING_CLEAN_MAP_MIN_NEIGHBORS=1
WEB_MAPPING_CLEAN_MAP_RADIUS=0.20
WEB_MAPPING_CLEAN_MAP_MIN_Z=-inf
WEB_MAPPING_CLEAN_MAP_MAX_Z=inf
WEB_MAPPING_CLEAN_MAP_MIN_RETENTION_RATIO=0.05
WEB_MAPPING_CLEAN_MAP_MIN_OUTPUT_POINTS=20000

# Extra raw launch args, for host-specific launch files.
WEB_MAPPING_EXTRA_LAUNCH_ARGS=
